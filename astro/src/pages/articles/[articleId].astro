---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArticleContent } from '@/components/ArticleContent';
import { getArticles, getArticleWithNodes } from '@/api/articles';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { articleId: article.id },
  }));
}

const { articleId } = Astro.params;

let content;
let nodes;
try {
  const result = await getArticleWithNodes(articleId);
  content = result.content;
  nodes = result.nodes;
} catch {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<BaseLayout
  title={`${content.title} | becraft-sdk Example`}
  description={`「${content.title}」- becraft-sdk サンプル`}
>
  <article class="max-w-3xl">
    <a
      href="/"
      class="mb-4 inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mr-2 h-4 w-4"
      >
        <path d="m12 19-7-7 7-7"></path>
        <path d="M19 12H5"></path>
      </svg>
      一覧に戻る
    </a>
    <h1 class="text-3xl font-bold tracking-tight">{content.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      {
        content.publishedAt && (
          <span class="text-sm text-muted-foreground">
            {new Date(content.publishedAt).toLocaleDateString('ja-JP')}
          </span>
        )
      }
      {
        content.categories.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {content.categories.map((category) => (
              <a
                href={`/?categoryId=${category.id}`}
                class="rounded-md bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary transition-colors hover:bg-primary/20"
              >
                {category.name}
              </a>
            ))}
          </div>
        )
      }
      {
        content.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {content.tags.map((tag) => (
              <a
                href={`/?tagId=${tag.id}`}
                class="rounded-md border border-border bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground transition-colors hover:bg-muted"
              >
                {tag.name}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <hr class="my-6 border-border" />
    <div class="prose prose-slate max-w-none">
      <ArticleContent client:load nodes={nodes} />
    </div>
  </article>
</BaseLayout>
